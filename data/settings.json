{
  "default_device_path": "/dev/input/event3",
  "virtual_port_name": "MIDITyper",
  "last_used_preset": "default_piano",
  "auto_detect_device": false,
  "min_velocity": 90,
  "max_velocity": 115,
  "start_captured": true,
  "caps_lock_capture_toggle_enabled": true,
  "theme": "dark",
  "app_global_mappings": {
    "KEY_F12": {
      "type": "action",
      "action": "TOGGLE_CAPTURE"
    },
    "KEY_ESC": {
      "type": "action",
      "action": "PANIC"
    },
    "KEY_F9": {
      "type": "action",
      "action": "PAGE_UP"
    },
    "KEY_F10": {
      "type": "action",
      "action": "PAGE_DOWN"
    }
  }
}